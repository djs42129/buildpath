# Copy to .env and fill in. .env is gitignored; never commit it.

# Riot Developer Portal key. Dev keys expire every 24h; replace with the
# personal product key once Riot approves it.
RIOT_API_KEY=

# Platform routing (league-v4, summoner-v4). na1 = North America.
REGION=na1

# Regional routing (match-v5). na1 maps to americas.
ROUTING=americas
